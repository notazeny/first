{
  "name": "heima-jizhang",
  "productName": "黑马记账",
  "version": "0.1.0",
  "description": "黑马记账——本地记账桌面应用（Windows / macOS）",
  "author": "黑马记账",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "echarts": "^6.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6",
    "vue": "^3.5.41"
  },
  "build": {
    "appId": "com.heima.jizhang",
    "productName": "黑马记账",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": ["out/**"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "黑马记账",
      "installerLanguages": ["zh_CN"],
      "language": 2052
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.finance"
    }
  }
}
